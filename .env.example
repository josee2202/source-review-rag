# Todas las variables son opcionales. Los valores por defecto están en IA-modulable/config/config.yaml.
# El backend lee este fichero si se copia como .env en la raíz del proyecto (no se versiona).
# No hace falta ninguna API key. Con Ollama en localhost y Qdrant en una ruta local, el procesamiento es local;
# si estas variables apuntan a otro equipo, los textos se envían a él.

# Servidor de Ollama
# OLLAMA_HOST_NAME=localhost
# OLLAMA_PORT=11434

# Modelos de Ollama
# EMBED_MODEL=nomic-embed-text
# LLM_MODEL=qwen3.5:4b-q4_K_M
# LLM_MAX_TOKENS=256
# LLM_TIMEOUT_S=120
# Hilos de CPU para el análisis. Sin definir, los elige Ollama.
# LLM_NUM_THREAD=8

# Qdrant: ruta local (modo embebido, relativa a la raíz del proyecto), URL de un servidor o :memory:
# QDRANT_LOCATION=qdrant_storage

# Front-end (variable de entorno del proceso de Streamlit): URL del backend
# API_URL=http://localhost:8010
